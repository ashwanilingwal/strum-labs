# Optional. Without these the app runs entirely on local storage and the
# sign-in button is hidden rather than shown-and-broken.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (no NEXT_PUBLIC_ prefix — never shipped to the browser). Lets
# "Delete account" remove the auth user as well as the synced state. Without
# it the button explains that deletion isn't set up and gives the contact email.
SUPABASE_SERVICE_ROLE_KEY=
